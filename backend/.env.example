NODE_ENV=development
PORT=3000

# Full URL or path prefix for all API + Socket.IO routes
# Examples:
#   http://localhost:3000/task-management-api
#   /task-management-api
BACK_END_DEFAULT_URL=http://localhost:3000/task-management-api
# Primary frontend URL (5174 is also allowed by default when Vite picks another port)
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_management
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h

# 64 hex chars = 32 bytes for AES-256
PATH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
REDIS_URL=redis://127.0.0.1:6379
