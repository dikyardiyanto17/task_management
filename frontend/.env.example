# --- Path prefix (NOT the full server URL) ---
VITE_BACK_END_DEFAULT_URL=/task-management-api

# --- Dev proxy target: origin ONLY (scheme + host, no /task-management-api) ---
# Local backend:
#   VITE_BACKEND_TARGET=http://localhost:3000
# Production API through nginx:
#   VITE_BACKEND_TARGET=https://residex.site

VITE_BACKEND_TARGET=http://localhost:3000

# Optional: full API URL override (production build)
# VITE_API_URL=https://residex.site/task-management-api/api
