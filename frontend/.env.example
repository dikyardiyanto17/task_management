# Frontend UI base path (Vite `base`, Vue Router history)
# Production: https://residex.site/task-management/
VITE_APP_BASE_PATH=/task-management

# API path prefix (NOT the UI path)
VITE_BACK_END_DEFAULT_URL=/task-management-api

# Dev proxy target — origin only
# VITE_BACKEND_TARGET=http://localhost:3000
# VITE_BACKEND_TARGET=https://residex.site
VITE_BACKEND_TARGET=http://localhost:3000

# Optional: full API URL (production build)
# VITE_API_URL=https://residex.site/task-management-api/api
