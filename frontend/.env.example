# Must match backend BACK_END_DEFAULT_URL path (Vite only reads VITE_* vars)
VITE_BACK_END_DEFAULT_URL=/task-management-api

# Optional: proxy target during local dev (default http://localhost:3000)
# VITE_BACKEND_TARGET=http://localhost:3000

# Optional: override full API URL (skips base path helper)
# VITE_API_URL=http://localhost:3000/task-management-api/api
